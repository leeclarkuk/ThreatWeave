{
  "name": "threatweave",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first threat modelling workbench",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @threatweave/core -w @threatweave/ai -w @threatweave/server -w @threatweave/cli -w @threatweave/web",
    "typecheck": "tsc -b packages/core packages/ai packages/server packages/cli && npm run typecheck -w @threatweave/web",
    "test": "vitest run",
    "start": "node packages/cli/dist/bin.js serve",
    "dev:web": "npm run dev -w @threatweave/web",
    "e2e": "node e2e/journey.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
